[Unit]
Description=Hearthstone Assistant API (uvicorn)
After=network.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/hearthstone-assistant/backend
Environment=PATH=/opt/hearthstone-assistant/backend/.venv/bin:/usr/local/bin:/usr/bin
EnvironmentFile=-/opt/hearthstone-assistant/backend/.env
ExecStart=/opt/hearthstone-assistant/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8101 --workers 2
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

# Hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
