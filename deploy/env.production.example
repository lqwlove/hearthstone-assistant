# Copy to backend/.env on the server (or keep a separate deploy/.env and symlink).
# chmod 600 backend/.env

APP_NAME=hearthstone-assistant
DEBUG=false
# Comma-separated browser origins that may call the API (include your public site URL)
CORS_ORIGINS=https://hs.example.com

# Prefer PostgreSQL in production
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/hearthstone_assistant

JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

SYNC_API_TOKEN=replace-sync-token
SKILL_ADMIN_TOKEN=

BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_REGION=us
BLIZZARD_LOCALE=zh_CN

LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

AGENT_MEMORY_BACKEND=auto
