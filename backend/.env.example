# App
APP_NAME=hearthstone-assistant
DEBUG=true
CORS_ORIGINS=http://localhost:5173

# Database (SQLite for local; use postgresql+psycopg://... for Postgres)
DATABASE_URL=sqlite:///./data/app.db

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Manual card sync protection (send as X-Sync-Token header)
SYNC_API_TOKEN=dev-sync-token

# Blizzard Hearthstone API
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_REGION=us
BLIZZARD_LOCALE=zh_CN

# LLM (openai | claude | mock)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini